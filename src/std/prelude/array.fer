// Arrays

impl<A> Value for [A] where A: Value {
	#[no_fuel_check]
	fn eq(left: [A], right: [A]) -> bool {
		let l = array_len(left);
		if l != array_len(right) {
			return false;
		};
		let mut i = 0;
		loop {
			if i >= l {
				return true;
			};
			if not eq(left->[array_offset_unchecked](i), right->[array_offset_unchecked](i)) {
				return false;
			};
			i += 1;
		}
	}

	#[no_fuel_check]
	fn to_string(value: [A]) -> string {
		let mut rendered = "[";
		let mut i = 0;
		loop {
			if i >= array_len(value) {
				string_push_str(rendered, "]");
				return rendered;
			};
			if i > 0 {
				string_push_str(rendered, ", ");
			};
			string_push_str(rendered, to_string(value->[array_offset_unchecked](i)));
			i += 1;
		}
	}

	#[no_fuel_check]
	fn hash(value: [A], state: &mut hasher) {
		let l = array_len(value);
		hasher_write_int(state, l);
		let mut i = 0;
		loop {
			if i >= l {
				return ();
			};
			hash(value->[array_offset_unchecked](i), state);
			i += 1;
		}
	}

	#[no_fuel_check]
	fn clone(source: [A]) -> [A] {
		let len = array_len(source);
		let mut target = array_with_capacity(len);
		let mut i = 0;
		loop {
			if i >= len {
				return target;
			};
			builtin::init_place(
				target.data->[buffer_slot](target.len),
				source.data->[buffer_slot](array_physical_offset_unchecked(source, i)),
			);
			target.len += 1;
			i += 1;
		}
	}

	#[no_fuel_check]
	fn drop(target: &mut [A]) {
		loop {
			let len = array_len(target);
			if len <= 0 {
				return ();
			};
			let index = len - 1;
			// Moving the element out and letting the temporary die is the drop: it goes through
			// the ordinary drop machinery, which MIR sees, rather than through a native holding a
			// runtime dictionary, which it does not. `buffer_take` never took a dictionary.
			buffer_take(target.data, array_physical_offset_unchecked(target, index));
			target.len -= 1;
		}
	}
}

impl<A> Inspect for [A] where A: Inspect {
	fn inspect(value: [A]) -> string {
		let mut rendered = "[";
		let mut i = 0;
		loop {
			if i >= array_len(value) {
				string_push_str(rendered, "]");
				return rendered;
			};
			if i > 0 {
				string_push_str(rendered, ", ");
			};
			string_push_str(rendered, inspect(value->[array_offset_unchecked](i)));
			i += 1;
		}
	}
}

/// Return the last element of an array, or None if the array is empty.
pub fn array_peek_back<A>(array: [A]) -> Option<A>
where
	A: Value
{
	let l = array_len(array);
	if l <= 0 {
		None
	} else {
		Some(array->[array_offset_unchecked](l - 1))
	}
}

/// Return the first element of an array, or None if the array is empty.
pub fn array_peek_front<A>(array: [A]) -> Option<A>
where
	A: Value
{
	let l = array_len(array);
	if l <= 0 {
		None
	} else {
		Some(array->[array_offset_unchecked](0))
	}
}

/// Append a value to the end of an array.
pub fn array_append<A>(array: &mut [A], value: A)
where
	A: Value
{
	array_ensure_capacity(array, array.len + 1);
	let index = array_wrap_index(array.capacity, array.start + array.len);
	builtin::init_place(array.data->[buffer_slot](index), value);
	array.len += 1;
}

/// Prepend a value to the start of an array.
pub fn array_prepend<A>(array: &mut [A], value: A)
where
	A: Value
{
	array_ensure_capacity(array, array.len + 1);
	if array.capacity > 0 {
		array.start = if array.start <= 0 {
			array.capacity - 1
		} else {
			array.start - 1
		};
	};
	builtin::init_place(array.data->[buffer_slot](array.start), value);
	array.len += 1;
}

/// Remove and return the last element of an array, or None if it is empty.
pub fn array_pop_back<A>(array: &mut [A]) -> Option<A>
where
	A: Value
{
	let len = array_len(array);
	if len <= 0 {
		None
	} else {
		let index = array_physical_offset_unchecked(array, len - 1);
		array.len -= 1;
		Some(buffer_take(array.data, index))
	}
}

/// Remove and return the first element of an array, or None if it is empty.
pub fn array_pop_front<A>(array: &mut [A]) -> Option<A>
where
	A: Value
{
	let len = array_len(array);
	if len <= 0 {
		None
	} else {
		let index = array.start;
		array.len -= 1;
		if array.len <= 0 {
			array.start = 0;
		} else {
			array.start += 1;
			if array.start >= array.capacity {
				array.start = 0;
			};
		};
		Some(buffer_take(array.data, index))
	}
}

fn array_slice_bound(len: int, index: int) -> int {
	let resolved = array_signed_index_to_offset(index, len);
	if resolved < 0 {
		len
	} else if resolved > len {
		len
	} else {
		resolved
	}
}

pub fn array_slice<A>(array: [A], start: int, end: int) -> [A]
where
	A: Value
{
	let len = array_len(array);
	let start = array_slice_bound(len, start);
	let end = array_slice_bound(len, end);
	let mut result = array_with_capacity(end - start);
	if end > start {
		let mut i = start;
		loop {
			if i < end {
				builtin::init_place(
					result.data->[buffer_slot](result.len),
					array.data->[buffer_slot](array_physical_offset_unchecked(array, i)),
				);
				result.len += 1;
				i += 1;
			} else {
				break;
			};
		};
	};
	result
}

impl Concat {
	fn concat(left, right) {
		let left_len = array_len(left);
		let right_len = array_len(right);
		let mut result = array_with_capacity(left_len + right_len);
		let mut i = 0;
		loop {
			if i < left_len {
				builtin::init_place(
					result.data->[buffer_slot](result.len),
					left.data->[buffer_slot](array_physical_offset_unchecked(left, i)),
				);
				result.len += 1;
				i += 1;
			} else {
				break;
			};
		};
		let mut i = 0;
		loop {
			if i < right_len {
				builtin::init_place(
					result.data->[buffer_slot](result.len),
					right.data->[buffer_slot](array_physical_offset_unchecked(right, i)),
				);
				result.len += 1;
				i += 1;
			} else {
				break;
			};
		};
		result
	}
}

// Iterator and Seq for array
#[private_repr]
pub struct ArrayIterator<A>
where
	A: Value
{
	array: [A],
	index: int,
}

impl<A> Iterator for <Self = ArrayIterator<A> |-> Item = A>
where
	A: Value
{
	fn next(a: &mut ArrayIterator<A>) -> Option<A> {
		if a.index < array_len(a.array) {
			let index = a.index;
			a.index += 1;
			Some(a.array->[array_offset_unchecked](index))
		} else {
			None
		}
	}
}

impl<A> Seq for <Self = [A] |-> Item = A, Iter = ArrayIterator<A>>
where
	A: Value
{
	fn iter(a: [A]) -> ArrayIterator<A> {
		ArrayIterator { array: a, index: 0 }
	}
}

impl<A, B> RebindItem for <Self = [A], Item = B |-> Output = [B]> {}

impl<I, T ! IterEffect> FromIterator for <Self = [T], Iter = I |-> Item = T ! IterEffect = IterEffect, FromIterEffect = (fallible, IterEffect)>
where
	I: Value,
	I: Iterator<Item = T ! NextEffect = IterEffect>
{
	fn from_iter(iterator: I) -> [T] {
		let mut iterator = iterator;
		let mut result = [];
		loop {
			match next(iterator) {
				Some(item) => {
					array_append(result, item);
				},
				None => return result,
			}
		}
	}
}

impl SizedSeq {
	fn len(a) {
		array_len(a)
	}
}

impl<A> Empty for [A] where A: Value {
	fn empty() -> [A] {
		array_with_capacity(0)
	}
}

impl<A> Default for [A] where A: Value {
	fn default() -> [A] {
		array_with_capacity(0)
	}
}
