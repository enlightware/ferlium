// Build semantic tags in Ferlium: their numeric identities belong to the compilation session.
fn ordering_from_code(code: int) -> Ordering {
    match code { -1 => Less, 0 => Equal, _ => Greater }
}

// Keep the known comparison identity available to MIR bounds and branch analysis.
impl Ord {
    #[inline(never)]
    fn cmp(left: int, right: int) -> Ordering { ordering_from_code(compare_int_code(left, right)) }
}
impl Ord {
    #[inline(never)]
    fn cmp(left: float, right: float) -> Ordering { ordering_from_code(compare_float_code(left, right)) }
}
impl Ord {
    #[inline(never)]
    fn cmp(left: string, right: string) -> Ordering { ordering_from_code(compare_string_code(left, right)) }
}

/// Returns `true` if `left` is NOT equal to `right`, otherwise `false`.
pub fn ne(left, right) {
	not eq(left, right)
}

/// Tests less than (for `left` and `right`) and is used by the < operator.
pub fn lt(left, right) {
	match cmp(left, right) {
		Less => true,
		_ => false,
	}
}

/// Tests less than or equal to (for `left` and `right`) and is used by the <= operator.
pub fn le(left, right) {
	match cmp(left, right) {
		Greater => false,
		_ => true,
	}
}

/// Tests greater than (for `left` and `right`) and is used by the > operator.
pub fn gt(left, right) {
	match cmp(left, right) {
		Greater => true,
		_ => false,
	}
}

/// Tests greater than or equal to (for `left` and `right`) and is used by the >= operator.
pub fn ge(left, right) {
	match cmp(left, right) {
		Less => false,
		_ => true,
	}
}

/// Returns the minimum of two values.
pub fn min(left, right) {
	match cmp(left, right) {
		Less => left,
		_ => right,
	}
}

/// Returns the maximum of two values.
pub fn max(left, right) {
	match cmp(left, right) {
		Greater => left,
		_ => right,
	}
}