/// A dynamic array supporting double ended queue operations.
#[private_repr]
#[no_derive_value]
pub struct array<A> {
	data: Buffer<A>,
	capacity: int,
	len: int,
	start: int,
}

fn array_len<A>(array: [A]) -> int {
	array.len
}

fn array_signed_index_to_offset(index: int, len: int) -> int {
	if index < 0 {
		len + index
	} else {
		index
	}
}

fn array_resolve_index(index: int, len: int) -> int {
	let resolved = array_signed_index_to_offset(index, len);
	if array_offset_in_bounds(resolved, len) {
		// Branch directly on the predicate so range analysis sees both successful bounds.
	} else {
		array_index_out_of_bounds(index, len);
	};
	resolved
}

// Kept out of line: every inlined access carries the check, and the message is built only on
// failure.
#[inline(never)]
fn array_index_out_of_bounds(index: int, len: int) {
	panic(f"Array access out of bounds: index {index} for length {len}")
}

// The check a range loop's accesses `base + stride * i` need, made once before the loop for every
// `i` the range yields, with `stride` 0 or 1. Fails exactly when one of those accesses would, and
// with the error the first failing one would raise: the loop is then certain to fail, so the
// language lets that error be raised before it runs.
//
// The indices form one run of consecutive integers. One that wraps passes `int::MAX`, which no
// length exceeds, so it fails like any other run with an index out of range.
fn array_loop_indices_check(base: int, stride: int, start: int, end: int, inclusive: bool, len: int) {
	let ascending = end >= start;
	let last = if inclusive {
		end
	} else if ascending {
		end - 1
	} else {
		end + 1
	};
	if not inclusive and start == end {
		// The range is empty: no access runs.
	} else {
		let first_index = base + stride * start;
		let last_index = base + stride * last;
		let (low, high) = if ascending {
			(first_index, last_index)
		} else {
			(last_index, first_index)
		};
		let valid = low <= high and -len <= low and high < len;
		if not valid {
			// Iteration order visits `first_index` first, then moves towards `last_index`.
			let index = if -len <= first_index and first_index < len {
				if ascending {
					len
				} else {
					-len - 1
				}
			} else {
				first_index
			};
			array_index_out_of_bounds(index, len)
		}
	}
}

fn array_physical_index<A>(array: [A], index: int) -> int {
	let resolved = array_resolve_index(index, array.len);
	array.start + resolved
}

/// Returns the physical slot for a logical offset already proved to be in the array.
///
/// Internal precondition: `0 <= offset < array.len`.
fn array_physical_offset_unchecked<A>(array: [A], offset: int) -> int {
	array.start + offset
}

/// Projects the element at a logical offset already proved to be in the array.
///
/// Internal precondition: `0 <= offset < array.len`.
subscript array_offset_unchecked<A>(array: [A], offset: int) -> A {
	ref mut {
		return effects_unsafe {
			array.data->[buffer_slot](array.start + offset, Value::<A>::SIZE)
		};
	}
}

subscript array_index<A>(array: [A], index: int) -> A {
	ref mut {
		let len = array_len(array);
		let resolved = array_resolve_index(index, len);
		return effects_unsafe {
			array.data->[buffer_slot](array.start + resolved, Value::<A>::SIZE)
		};
	}
}

fn array_with_capacity<A>(capacity: int) -> [A] {
	let capacity = if capacity < 0 { 0 } else { capacity };
	array {
		data: buffer_with_capacity(capacity, Value::<A>::SIZE, Value::<A>::ALIGN),
		capacity: capacity,
		len: 0,
		start: 0,
	}
}

/// Makes room for one element after the last one.
fn array_reserve_back<A>(array: &mut [A])
{
	if array.start + array.len >= array.capacity {
		array_grow_back(array)
	}
}

/// Makes room for one element before the first one.
fn array_reserve_front<A>(array: &mut [A])
{
	if array.start <= 0 {
		array_grow_front(array)
	}
}

// Kept out of line: callers inline the room check, and growth runs rarely.
#[inline(never)]
fn array_grow_back<A>(array: &mut [A])
{
	// An empty array can reuse its buffer without moving any elements.
	if array.len <= 0 and array.capacity > 0 {
		array.start = 0;
		return;
	};
	let front = array_kept_room(array.start, array.len);
	array_reallocate(array, front, array_added_room(array.len))
}

// Kept out of line: callers inline the room check, and growth runs rarely.
#[inline(never)]
fn array_grow_front<A>(array: &mut [A])
{
	// An empty array can reuse its buffer without moving any elements.
	if array.len <= 0 and array.capacity > 0 {
		array.start = array.capacity;
		return;
	};
	let back = array_kept_room(array.capacity - array.start - array.len, array.len);
	array_reallocate(array, array_added_room(array.len), back)
}

// The free slots the full end gets: as many as there are elements, so that pure growth at one end
// doubles the capacity. Sized from the length rather than the capacity, so that a queue of steady
// length (`append` and `pop_front`) keeps a bounded buffer.
fn array_added_room(len: int) -> int {
	if len > 0 {
		len
	} else {
		1
	}
}

// The free slots the other end keeps: dropping them would make an array growing at both ends in
// turn reallocate on every operation, while capping them at the length bounds what a queue's
// abandoned front costs.
fn array_kept_room(room: int, len: int) -> int {
	if room < len {
		room
	} else {
		len
	}
}

/// Moves the elements into a new buffer with `front` free slots before them and `back` after them.
fn array_reallocate<A>(array: &mut [A], front: int, back: int)
{
	let new_capacity = front + array.len + back;
	let element_size = Value::<A>::SIZE;
	let mut new_data = buffer_with_capacity(new_capacity, element_size, Value::<A>::ALIGN);
	let mut i = 0;
	loop {
		if i < array.len {
			buffer_move_into(array.data, array.start + i, new_data, front + i, element_size);
			i += 1;
		} else {
			break;
		};
	};
	buffer_move(new_data, array.data);
	array.capacity = new_capacity;
	array.start = front;
}
